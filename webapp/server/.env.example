# Must match VITE_SUPABASE_URL in client/.env (same project ref)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Anonymous scan limit: free scans per IP per 24h before signup prompt (default: 2)
# ANON_SCAN_LIMIT=2

# Set to "true" to log auth API calls (getUser, token validation) to the terminal
# DEBUG_AUTH=true

# Use mock greenfield enricher (no Claude API key required) for local dev
# USE_MOCK_GREENFIELD=true

# Restrict materialize targetRoot to this base directory (e.g. /tmp/projects)
# When set, targetRoot must be within this path. Leave unset for no restriction (dev only).
# PROJECTS_BASE_DIR=/tmp/projects

# Log task and materialize metrics to stdout
# METRICS_LOG=1
