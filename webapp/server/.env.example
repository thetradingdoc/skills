# Base URL for share links (e.g. https://yourapp.com). Used when generating share URLs.
# APP_URL=https://yourapp.com

# Must match VITE_SUPABASE_URL in client/.env (same project ref)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Anonymous scan limit: free scans per IP per 24h before signup prompt (default: 2)
# ANON_SCAN_LIMIT=2

# Set to "true" to log auth API calls (getUser, token validation) to the terminal
# DEBUG_AUTH=true

# Allow unauthenticated chat requests from localhost (for ./webapp/scripts/test-chat.sh).
# Only enable in local dev. Set to 1 to bypass Bearer token for localhost.
# CHAT_DEV_BYPASS=1

# Billing gate bypass for local / owner use (P1 assisted design loop).
# BILLING_DEV_UNLIMITED=1 → canUseAiAgent + canUseDesignChat + canScan for every user (local only).
# OWNER_USER_IDS=dev-bypass-user,your-supabase-user-uuid → unlimited for listed ids only.
# BILLING_DEV_UNLIMITED=1
# OWNER_USER_IDS=dev-bypass-user

# Use mock greenfield enricher (no Claude API key required) for local dev
# USE_MOCK_GREENFIELD=true

# Restrict materialize targetRoot to this base directory (e.g. /tmp/projects)
# When set, targetRoot must be within this path. Leave unset for no restriction (dev only).
# PROJECTS_BASE_DIR=/tmp/projects

# Log task and materialize metrics to stdout
# METRICS_LOG=1

# --- Stripe billing (chat onboarding + Profile portal) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...
# FREE_SCAN_LIMIT_MONTHLY=5
# FREE_DESIGN_MESSAGES_MONTHLY=20
# PRO_SCAN_CREDITS=100
# TEAM_SCAN_CREDITS=500
# PRO_AI_CREDITS_CENTS=2000
# TEAM_AI_CREDITS_CENTS=10000
# Create products: node --import tsx scripts/stripe-setup-prices.ts
# Portal: enable cancel + payment method in Stripe Dashboard → Settings → Billing → Customer portal
