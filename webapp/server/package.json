{
  "name": "arch-visualizer-server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "build:watch": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outdir=dist --watch",
    "dev": "npm run build && node --watch dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jose": "^6.1.3",
    "langsmith": "^0.5.7",
    "nanoid": "^5.1.6",
    "openai": "^4.72.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
