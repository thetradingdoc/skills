# Must match SUPABASE_URL in server/.env (same project ref)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Set to "true" to log auth state changes and API calls in the browser console
# VITE_DEBUG_AUTH=true

# Stripe publishable key (Payment Element in onboarding chat)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
